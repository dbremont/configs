#!/usr/bin/env bash

MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Only prepare the template when Git launches the editor with no message
# source. Explicit sources (-m, --amend, cherry-pick, merge, ...) and the
# messages they carry must be preserved as-is.
if [[ -n "$COMMIT_SOURCE" ]]; then
    exit 0
fi

BRANCH=$(git branch --show-current)

# Extract Jira key from branch names such as:
#   20260624-SGF-11181
#   20260624-sgf-11181
#   feature/20260624-SGF-11181-login
# Produces:
#   SGF-11181
JIRA=$(echo "$BRANCH" |
    grep -Eio '[A-Z]{2,10}-[0-9]+' |
    head -n1 |
    tr '[:lower:]' '[:upper:]')

if [[ -z "$JIRA" ]]; then
    REF="$BRANCH"
else
    REF="$JIRA"
fi

FILES=$(git diff --cached --name-only | sed 's/^/- /')

cat >"$MSG_FILE" <<EOF
type($REF): message

body? optional

Appended Information:
$FILES

EOF